# HirePilot AI Backend Environment Example
# Copy this file to .env locally and fill real values.
# Never commit backend/.env to GitHub.

PORT=5000

DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hirepilot_db

JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=1d

# Frontend URL used in password reset links
FRONTEND_URL=http://localhost:3000

# Email sender for development only.
# For production, use a provider like SendGrid, Resend, Mailgun, Amazon SES, etc.
EMAIL_USER=your_sender_email@example.com
EMAIL_PASS=your_email_app_password_or_provider_secret

# Optional future production settings
RESET_TOKEN_EXPIRES_MINUTES=15
NODE_ENV=development
