# HirePilot AI Backend Environment Example
# Copy this file to .env locally and fill real values.
# Never commit backend/.env to GitHub.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hirepilot_db
DB_USER=postgres
DB_PASSWORD=your_database_password

JWT_SECRET=replace_with_long_random_secret

# Frontend URL used in password reset links
FRONTEND_URL=http://localhost:3000

# Email sender for development only.
# For production, use a provider like SendGrid, Resend, Mailgun, Amazon SES, etc.
EMAIL_USER=your_sender_email@example.com
EMAIL_PASS=your_email_app_password_or_provider_secret

# Local Python worker coordination.
# The current worker performs safe local demo/simulation flows only.
AI_WORKER_ENABLED=true
AI_WORKER_URL=http://127.0.0.1:8000
AI_WORKER_TIMEOUT_MS=30000
AI_WORKER_HEALTH_TIMEOUT_MS=5000
AI_AGENT_QUEUE_ENABLED=true

# Additional local application settings
PORT=5000
JWT_EXPIRES_IN=1d
RESET_TOKEN_EXPIRES_MINUTES=15
NODE_ENV=development
