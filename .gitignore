# HirePilot AI - Git ignore rules

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/
ai-agent/.venv/
ai-agent/venv/
venv/
.venv/

# Environment / secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
ai-agent/.env
ai-agent/.env.*
!ai-agent/.env.example

# Build output
frontend/build/
frontend/dist/
backend/dist/
dist/
build/

# Uploaded resumes and personal/private documents
backend/uploads/
backend/uploads/*
frontend/uploads/
uploads/
docs/private/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / cache
.cache/
.parcel-cache/
coverage/
.nyc_output/
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local database dumps / backups
*.sql
*.dump
*.backup
*.sqlite
*.sqlite3

# Temporary files
.tmp/
tmp/
temp/




# Always include database migration scripts
!database/
!database/migrations/
!database/migrations/*.sql